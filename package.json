{
  "name": "smile-click-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/start.mjs",
    "build": "tsc && vite build",
    "preview": "node scripts/start.mjs --preview",
    "start": "node scripts/start.mjs --preview",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "import:assets": "node --env-file-if-exists=.env server/index.mjs --import-assets",
    "cloud:setup": "node scripts/cloud-setup.mjs",
    "test": "node --test server/studio.test.mjs server/cloud.test.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
