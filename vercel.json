{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/studio.js": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/studio?route=:path*" },
    { "source": "/robots.txt", "destination": "/api/studio?route=robots" },
    { "source": "/sitemap.xml", "destination": "/api/studio?route=sitemap" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/admin/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
